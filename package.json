{
  "name": "agent-robot-avatar",
  "version": "0.2.1",
  "description": "A lightweight expressive robot avatar Web Component for AI agents and interactive applications.",
  "type": "module",
  "main": "./agent-robot-avatar.js",
  "module": "./agent-robot-avatar.js",
  "types": "./index.d.ts",
  "browser": "./agent-robot-avatar.js",
  "unpkg": "./agent-robot-avatar.js",
  "jsdelivr": "./agent-robot-avatar.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./agent-robot-avatar.js",
      "default": "./agent-robot-avatar.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "check": "node scripts/check-source.mjs",
    "test": "npm run check && npm run test:types && npm run test:release && npm run test:package && npm run test:browser && npm run build:pages",
    "release:check": "npm test && npm publish --dry-run --ignore-scripts --tag latest",
    "prepublishOnly": "npm test && node scripts/check-publish-tag.mjs",
    "test:types": "tsc -p tsconfig.types.json",
    "test:release": "node --test tests/release.test.mjs",
    "test:package": "node --test tests/package.test.mjs",
    "test:browser": "playwright test"
  },
  "files": [
    "agent-robot-avatar.js",
    "index.d.ts",
    "src/",
    "assets/support/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "robot",
    "avatar",
    "web-component",
    "svg",
    "svg-animation",
    "animation",
    "interactive",
    "vanilla-javascript",
    "ui"
  ],
  "author": "CX ArtLab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CX-ARTLab/agent-robot-avatar.git"
  },
  "homepage": "https://github.com/CX-ARTLab/agent-robot-avatar#readme",
  "bugs": {
    "url": "https://github.com/CX-ARTLab/agent-robot-avatar/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/P0E625WIOI"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "7.0.2"
  }
}
